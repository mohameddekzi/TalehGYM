# ─────────────────────────────────────────────────────────────
# Taleh GYM — environment variables
# Copy this file to `.env.local` and fill in the values.
#   cp .env.local.example .env.local
# `.env.local` is git-ignored; this example file is safe to commit/share.
# ─────────────────────────────────────────────────────────────

# ── Supabase (database) ──────────────────────────────────────
# Public project URL and publishable (anon) key. Safe to expose in the
# browser — Row Level Security governs what this key can do.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://mmnavtwjwxlevqrqwazf.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_fnoPdY5Hha-MgGNp1OxrDQ_NsbYY2K2"

# ── ZKTeco Access Control API (server-only) ──────────────────
# Shared secret the fingerprint-door bridge uses to call /api/access/*.
# CHANGE THIS IN PRODUCTION to a long random value, and set the same
# value in the bridge's environment.
ACCESS_API_KEY="taleh-zkt-2026"


# ─────────────────────────────────────────────────────────────
# Bridge only (../bridge) — the Node.js program that runs on a PC /
# Raspberry Pi at the gym and talks to the ZKTeco terminals.
# These are NOT read by the Next.js app; set them where the bridge runs.
# ─────────────────────────────────────────────────────────────
# API_BASE="https://taleh-gym.vercel.app"   # the deployed app URL
# ACCESS_API_KEY="taleh-zkt-2026"           # must match the value above
# AGENT_PORT="4000"                          # local enroll-button agent
# SYNC_MS="120000"                           # enrolment sync interval (ms)
# Enrolment (reception) terminal and door terminal(s), as JSON:
# ZK_ENROLL='{"name":"Reception (enroll)","ip":"192.168.1.201","port":4370}'
# ZK_DOORS='[{"name":"Main Door","ip":"192.168.1.202","port":4370}]'
