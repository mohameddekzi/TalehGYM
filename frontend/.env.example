# Taleh GYM — server environment variables
# Copy to .env.local for local development, and set the same in Vercel.

# MongoDB Atlas connection string (server-only, never exposed to the browser)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/talehgym?retryWrites=true&w=majority"

# Database name (optional, defaults to "talehgym")
MONGODB_DB="talehgym"

# Secret key required to call POST /api/seed (optional, defaults to "taleh-seed-2026")
SEED_KEY="taleh-seed-2026"
